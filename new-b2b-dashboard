<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Employer SEO Intelligence Command Center</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.0/chart.umd.min.js"></script>
<style>
:root{
  --bg:#0b0f17; --panel:#121826; --panel2:#161e2e; --border:#232c3d;
  --text:#e7ecf5; --muted:#8a96ab; --accent:#4f7cff; --accent2:#22c3a6;
  --red:#ff5d6c; --orange:#ffa940; --yellow:#ffd23f; --green:#2ecc8f;
  --p0:#ff5d6c; --p1:#ffa940; --p2:#ffd23f; --ignore:#5a6478;
  font-size:14px;
}
*{box-sizing:border-box;}
body{margin:0;background:var(--bg);color:var(--text);font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;}
a{color:var(--accent);}
.app{display:flex;min-height:100vh;}

/* ---------- SIDEBAR ---------- */
.sidebar{width:250px;flex:0 0 250px;background:var(--panel);border-right:1px solid var(--border);
  position:sticky;top:0;height:100vh;overflow-y:auto;padding:16px 0;}
.brand{padding:0 16px 16px 16px;border-bottom:1px solid var(--border);margin-bottom:12px;}
.brand .logo{font-weight:800;font-size:15px;letter-spacing:.3px;color:var(--text);}
.brand .sub{font-size:11px;color:var(--muted);margin-top:2px;}
.navgroup-label{font-size:10px;text-transform:uppercase;letter-spacing:.08em;color:var(--muted);padding:14px 16px 6px;}
.navitem{display:flex;align-items:center;gap:8px;padding:9px 16px;font-size:13px;color:var(--muted);cursor:pointer;border-left:3px solid transparent;}
.navitem .num{font-size:10px;color:#57607a;font-variant-numeric:tabular-nums;width:18px;flex:0 0 18px;}
.navitem:hover{color:var(--text);background:rgba(255,255,255,.03);}
.navitem.active{color:var(--text);background:rgba(79,124,255,.12);border-left-color:var(--accent);font-weight:600;}

/* ---------- MAIN ---------- */
.main{flex:1;min-width:0;display:flex;flex-direction:column;}
.topbar{position:sticky;top:0;z-index:20;background:rgba(11,15,23,.92);backdrop-filter:blur(6px);
  border-bottom:1px solid var(--border);padding:10px 22px;display:flex;align-items:center;gap:14px;flex-wrap:wrap;}
.topbar h1{font-size:15px;margin:0;font-weight:700;flex:0 0 auto;}
.filterbar{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-left:auto;}
.pill-select{background:var(--panel2);border:1px solid var(--border);color:var(--text);border-radius:8px;
  padding:6px 10px;font-size:12px;}
.toggle{display:flex;align-items:center;gap:6px;font-size:12px;color:var(--muted);cursor:pointer;user-select:none;}
.toggle input{accent-color:var(--accent);}
.btn{background:var(--accent);color:#fff;border:none;border-radius:8px;padding:7px 14px;font-size:12px;font-weight:600;cursor:pointer;}
.btn.secondary{background:var(--panel2);color:var(--text);border:1px solid var(--border);}
.btn:hover{filter:brightness(1.1);}
.content{padding:22px;max-width:1500px;width:100%;margin:0 auto;}
.tab-panel{display:none;}
.tab-panel.active{display:block;}

/* ---------- UPLOAD SCREEN ---------- */
.upload-screen{max-width:720px;margin:60px auto;text-align:center;}
.upload-screen h1{font-size:26px;margin-bottom:6px;}
.upload-screen p{color:var(--muted);font-size:13px;line-height:1.6;}
.dropzone{margin-top:24px;border:2px dashed var(--border);border-radius:16px;padding:44px 20px;cursor:pointer;background:var(--panel);}
.dropzone:hover{border-color:var(--accent);}
.dropzone .big{font-size:15px;font-weight:600;margin-bottom:6px;}
.dropzone .small{font-size:12px;color:var(--muted);}
.steps{text-align:left;margin-top:28px;background:var(--panel);border:1px solid var(--border);border-radius:12px;padding:18px 20px;}
.steps h3{font-size:13px;margin:0 0 10px;color:var(--muted);text-transform:uppercase;letter-spacing:.05em;}
.steps ol{margin:0;padding-left:18px;font-size:13px;line-height:1.9;color:#c3cbdb;}
.ga4box{margin-top:16px;font-size:12px;color:var(--muted);}
.ga4box button{margin-left:6px;}

/* ---------- CARDS / KPIS ---------- */
.grid{display:grid;gap:14px;}
.grid.kpi{grid-template-columns:repeat(auto-fit,minmax(190px,1fr));}
.card{background:var(--panel);border:1px solid var(--border);border-radius:12px;padding:16px;}
.kpi .label{font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.04em;margin-bottom:8px;}
.kpi .value{font-size:24px;font-weight:800;}
.kpi .delta{font-size:11px;margin-top:6px;}
.delta.up{color:var(--green);} .delta.down{color:var(--red);} .delta.flat{color:var(--muted);}
.section-title{display:flex;align-items:center;justify-content:space-between;margin:28px 0 12px;}
.section-title h2{font-size:16px;margin:0;}
.section-title .hint{font-size:11px;color:var(--muted);}
.section-desc{font-size:12px;color:var(--muted);margin:-6px 0 14px;max-width:900px;line-height:1.6;}

/* ---------- TABLES ---------- */
table{width:100%;border-collapse:collapse;font-size:12.5px;}
th{text-align:left;color:var(--muted);font-weight:600;font-size:10.5px;text-transform:uppercase;letter-spacing:.04em;
  padding:8px 10px;border-bottom:1px solid var(--border);cursor:pointer;white-space:nowrap;position:sticky;top:0;background:var(--panel);}
td{padding:8px 10px;border-bottom:1px solid rgba(255,255,255,.04);vertical-align:top;}
tr:hover td{background:rgba(255,255,255,.02);}
.table-wrap{max-height:520px;overflow:auto;border:1px solid var(--border);border-radius:12px;background:var(--panel);}
.table-scroll{overflow-x:auto;}
.badge{display:inline-block;padding:2px 8px;border-radius:999px;font-size:10.5px;font-weight:700;white-space:nowrap;}
.badge.p0{background:rgba(255,93,108,.15);color:var(--p0);}
.badge.p1{background:rgba(255,169,64,.15);color:var(--p1);}
.badge.p2{background:rgba(255,210,63,.15);color:#e6bb2e;}
.badge.ignore{background:rgba(90,100,120,.2);color:#9aa4ba;}
.badge.blue{background:rgba(79,124,255,.15);color:#7ea0ff;}
.badge.green{background:rgba(46,204,143,.15);color:var(--green);}
.badge.gray{background:rgba(255,255,255,.06);color:var(--muted);}
.bar{height:6px;border-radius:4px;background:var(--panel2);overflow:hidden;position:relative;min-width:60px;}
.bar > span{display:block;height:100%;background:var(--accent);}
.mono{font-variant-numeric:tabular-nums;}
.urlcell{max-width:280px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-family:ui-monospace,Menlo,monospace;font-size:11.5px;color:#a9c3ff;}
.querycell{max-width:220px;}
.small-muted{color:var(--muted);font-size:11px;}
.empty-state{padding:40px;text-align:center;color:var(--muted);font-size:13px;}
.na{color:#5a6478;font-style:italic;}

/* ---------- EXPLAIN / WHY PANEL ---------- */
.why-btn{background:none;border:1px solid var(--border);color:var(--muted);border-radius:6px;padding:2px 8px;font-size:10.5px;cursor:pointer;}
.why-btn:hover{color:var(--text);border-color:var(--accent);}
.why-panel{display:none;background:var(--panel2);border:1px solid var(--border);border-radius:10px;padding:12px 14px;margin-top:6px;font-size:12px;}
.why-panel.open{display:block;}
.why-panel .comp{display:flex;justify-content:space-between;padding:3px 0;border-bottom:1px dashed rgba(255,255,255,.06);}
.why-panel .comp:last-child{border-bottom:none;}

/* ---------- ACTION CENTER ---------- */
.action-cols{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;}
.action-col h3{font-size:12px;margin:0 0 10px;display:flex;align-items:center;gap:6px;}
.action-card{background:var(--panel);border:1px solid var(--border);border-left:3px solid var(--accent);border-radius:10px;
  padding:12px;margin-bottom:10px;font-size:12px;}
.action-card .t{font-weight:700;margin-bottom:4px;}
.action-card .m{color:var(--muted);font-size:11px;line-height:1.5;}
.action-card .tag{display:inline-block;margin-top:6px;font-size:10px;padding:2px 6px;border-radius:6px;background:var(--panel2);color:var(--muted);}

/* ---------- FUNNEL ---------- */
.funnel{display:flex;flex-direction:column;gap:6px;max-width:520px;margin:0 auto;}
.funnel-step{background:linear-gradient(90deg,var(--accent),var(--accent2));border-radius:8px;padding:10px 16px;
  color:#08121f;font-weight:700;font-size:12.5px;display:flex;justify-content:space-between;}
.funnel-step .n{font-size:15px;}
.funnel-arrow{text-align:center;color:var(--muted);font-size:11px;}

/* ---------- MISC ---------- */
.two-col{display:grid;grid-template-columns:1.3fr 1fr;gap:16px;}
.chip-row{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:12px;}
.chip{background:var(--panel2);border:1px solid var(--border);border-radius:999px;padding:5px 12px;font-size:11.5px;color:var(--muted);cursor:pointer;}
.chip.active{background:var(--accent);color:#fff;border-color:var(--accent);}
footer.credits{padding:26px;text-align:center;color:#4a5470;font-size:11px;}
.search-input{background:var(--panel2);border:1px solid var(--border);color:var(--text);border-radius:8px;padding:6px 10px;font-size:12px;min-width:200px;}
.flexrow{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-bottom:14px;}
.editable-note{font-size:11px;color:var(--muted);background:var(--panel2);border:1px dashed var(--border);border-radius:8px;padding:8px 12px;margin-bottom:12px;}
@media(max-width:1100px){.action-cols{grid-template-columns:1fr 1fr;} .two-col{grid-template-columns:1fr;}}
</style>
</head>
<body>
<div id="uploadScreen" class="upload-screen">
  <div class="brand" style="border:none;text-align:center;">
    <div class="logo">🏢 EMPLOYER SEO INTELLIGENCE COMMAND CENTER</div>
    <div class="sub">Unstop — /employers/ business line</div>
  </div>
  <h1>Upload your GSC export</h1>
  <p>Export from Google Search Console → Performance → Export → Download Excel (.xlsx). The standard export (Queries + Pages + Countries + Devices tabs) works as-is — Google Search Console does not offer a combined Query+Page export from the UI, so the dashboard infers the most likely page for each query by topic/keyword match and labels those matches "≈ inferred". If you separately have a real combined Query+Page export (e.g. built by drilling into individual pages in GSC and merging the results), upload that instead for exact per-query URLs and full Cannibalization detection.</p>
  <div class="dropzone" id="dropzone">
    <div class="big">Drop your GSC export here</div>
    <div class="small">or click to browse · .xlsx .xls .csv supported</div>
    <input type="file" id="fileInput" accept=".xlsx,.xls,.csv" style="display:none;">
  </div>
  <div class="ga4box">Optional: <button class="btn secondary" id="ga4Btn" type="button">+ Add GA4 export (for conversions/revenue)</button><input type="file" id="ga4Input" accept=".xlsx,.xls,.csv" style="display:none;"><span id="ga4Status"></span></div>
  <div class="steps">
    <h3>How to export</h3>
    <ol>
      <li>Open <b>search.google.com/search-console</b> → select the unstop.com property</li>
      <li>Click <b>Performance</b> → set your date range</li>
      <li>Click <b>Export</b> (top right) → <b>Download Excel (.xlsx)</b> — no special dimension setup needed</li>
      <li>Upload it above — the Employer Command Center builds automatically</li>
    </ol>
  </div>
  <div id="engineStatus" class="small-muted" style="margin-top:14px;"></div>
  <div style="margin-top:18px;"><button class="btn secondary" id="demoBtn" type="button">Try it with sample /employers/ data</button></div>
</div>

<div id="app" class="app" style="display:none;"></div>

<script>
/* =========================================================================
   EMPLOYER SEO INTELLIGENCE COMMAND CENTER
   Single-file, client-side. No data leaves the browser. No fabricated
   metrics: anything not derivable from the uploaded export is rendered as
   "DATA NOT AVAILABLE / REQUIRES GA4 / REQUIRES SERP DATA".
   ========================================================================= */
(function(){
"use strict";

/* -------------------------------------------------------------------------
   1. CONFIG — editable taxonomy, keyword dictionaries, scoring weights.
   Everything here is intentionally data, not hardcoded logic, so the
   Employer team can extend it (new URLs, new categories, new keywords)
   without touching the engine below. Edit CONFIG.* and reload.
   ------------------------------------------------------------------------- */
const CONFIG = {

  // Only URLs whose path starts with one of these are considered "Employer"
  // business-area pages when the global filter is ON.
  employerPathPrefixes: ["/employers"],

  // Paths that MUST be excluded from Employer mode even if they nest under
  // an employer path segment somewhere, unless the "include supporting
  // pages" toggle is ON.
  nonEmployerPathHints: ["/jobs/","/internships/","/students/","/colleges/","/competitions/","/practice/","/quiz/","/hackathons/","/events/"],

  // Per-URL classification + full keyword taxonomy now comes from
  // CONFIG.urlProfiles (appended right after this object — sourced from the
  // team's "B2B Planning & Strategy" file: 31 /employers/ URLs × TOFU/MOFU/BOFU,
  // funnel stage, problem/solution/product keyword buckets, ICP, job role).
  // Any URL NOT in urlProfiles falls through to the heuristic classifier below
  // (e.g. a brand-new page the taxonomy file hasn't been updated for yet).

  // Fallback heuristics for URLs NOT in urlProfiles (any new/unmapped page).
  // Order matters — first match wins. Tested against the lower-cased path.
  urlTypeHeuristics: [
    { test:p=>/\/(blog|resources\/blog)\//.test(p), type:"BLOG" },
    { test:p=>/\bguide\b|\bhow-to\b/.test(p), type:"GUIDE" },
    { test:p=>/case-stud|success-story|customer-story/.test(p), type:"CASE STUDY" },
    { test:p=>/\bvs\b|comparison|alternative/.test(p), type:"COMPARISON" },
    { test:p=>/pricing|plans/.test(p), type:"RESOURCE" },
    { test:p=>p.split("/").filter(Boolean).length<=1, type:"LANDING PAGE" },
    { test:p=>p.split("/").filter(Boolean).length===2, type:"SOLUTION" },
    { test:p=>p.split("/").filter(Boolean).length>=3, type:"FEATURE" }
  ],
  // Real 7-cluster taxonomy from the team's Cluster sheet (+ the /employers hub).
  // Order matters — subpaths of ai-assessment-agent / ai-sourcing-agent must be
  // tested BEFORE their parent product hub.
  urlCategoryHeuristics: [
    { test:p=>/ai-assessment-agent\/(aptitude-test|online-coding-test|sql-assessments|technical-role-based-tests|business-competency-simulation-games|communication-assessment)/.test(p), category:"ASSESSMENTS" },
    { test:p=>/ai-sourcing-agent\/(jobs-internships-listings-jobboard|our-largest-early-talent-community)/.test(p), category:"TALENT SOURCING" },
    { test:p=>/ai-sourcing-agent|ai-screening-agent|ai-assessment-agent|ai-proctoring-agent|ai-interview-agent|ai-calling-agent|ai-scheduling-agent/.test(p), category:"AI RECRUITMENT" },
    { test:p=>/ats-software|schedul|automat/.test(p), category:"RECRUITMENT TECHNOLOGY" },
    { test:p=>/brand-and-advertise|advertis/.test(p), category:"RECRUITMENT MARKETING" },
    { test:p=>/employer-branding/.test(p), category:"EMPLOYER BRANDING" },
    { test:p=>/hiring-talent-platform|campus-hiring|lateral-hiring|virtual-hiring|\/hiring\b/.test(p), category:"HIRING" }
  ],

  // BUSINESS PROBLEM -> SOLUTION -> PRODUCT -> OUTCOME, keyed by the real
  // 7-cluster taxonomy (+ hub). Used only as a fallback for URLs that aren't
  // in CONFIG.urlProfiles — every known /employers/ URL uses its own
  // page-specific problem/solution/product from urlProfiles instead.
  businessMap: {
    "HIRING": { problem:"Needs a faster, centralized way to hire across roles", solution:"Unified hiring & talent platform", product:"Hiring & Talent Platform", outcome:"Faster time-to-hire, centralized pipeline" },
    "EMPLOYER BRANDING": { problem:"Weak visibility / attractiveness to candidates", solution:"Employer branding & engagement campaigns", product:"Employer Branding Suite", outcome:"Stronger brand recall, more inbound applicants" },
    "AI RECRUITMENT": { problem:"Recruiters spend too much time sourcing, screening & interviewing", solution:"AI-driven recruitment automation", product:"AI Recruitment Agents (Sourcing/Screening/Interview/Calling)", outcome:"Reduced recruiter workload, faster shortlisting" },
    "ASSESSMENTS": { problem:"Hard to objectively evaluate candidate skills at scale", solution:"Standardized online skill assessments", product:"AI Assessment Agent", outcome:"Objective, scalable skill evaluation" },
    "TALENT SOURCING": { problem:"Struggling to find enough qualified candidates", solution:"AI-powered candidate sourcing & talent community", product:"AI Sourcing Agent", outcome:"Larger, higher-quality candidate pipeline" },
    "RECRUITMENT TECHNOLOGY": { problem:"Manual, disconnected recruitment workflows", solution:"End-to-end applicant tracking & automation", product:"ATS Software", outcome:"Fewer manual steps, faster pipeline velocity" },
    "RECRUITMENT MARKETING": { problem:"Employer content doesn't reach the right candidates", solution:"Recruitment marketing & brand advertising", product:"Brand & Advertise Solution", outcome:"More qualified inbound applicant traffic" },
    "EMPLOYER SOLUTIONS": { problem:"General hiring / employer challenge, not yet specific", solution:"Full employer product suite", product:"Unstop for Employers (hub)", outcome:"Entry point to the matched solution" }
  },

  allCategories: ["EMPLOYER SOLUTIONS","HIRING","EMPLOYER BRANDING","AI RECRUITMENT","ASSESSMENTS","TALENT SOURCING","RECRUITMENT TECHNOLOGY","RECRUITMENT MARKETING"],

  // Branded query detection (used to flag Navigational intent, not to hard-exclude).
  brandTerms: ["unstop","un stop","un-stop"],

  // ---- SEARCH INTENT — multi-signal keyword lexicons (weighted) ----------
  intentLexicon: {
    TRANSACTIONAL: { base:88, terms:["pricing","price","cost","demo","free trial","book a demo","contact sales","get a quote","buy","sign up","request a demo","talk to an expert","get started"] },
    "COMMERCIAL INVESTIGATION": { base:72, terms:["best","top 10","top","vs","versus","comparison","compare","alternative","alternatives","review","reviews"] },
    "PRODUCT AWARE": { base:62, terms:["platform","software","tool","solution","agent","system","app","suite"] },
    "SOLUTION AWARE": { base:44, terms:["how to hire","how to reduce","how to improve","ways to","improve hiring","reduce screening","hiring strategy","recruitment strategy","hiring process"] },
    "PROBLEM AWARE": { base:30, terms:["why is hiring","struggling to hire","hiring challenges","recruitment problems","difficulty finding","hard to find candidates","time to hire is high"] },
    INFORMATIONAL: { base:16, terms:["what is","guide","definition","meaning","examples","types of","benefits of"] },
    NAVIGATIONAL: { base:6, terms:["login","sign in","careers","contact us"] }
  },

  // Extra explicit strong-buying-intent phrases (spec section 4 examples) — each
  // partial match adds points on top of the intent base score, capped at 100.
  strongBuyingIntentPhrases: ["hiring platform","recruitment platform","recruitment software","campus hiring platform",
    "ai recruitment software","ai hiring solution","bulk hiring solution","talent acquisition platform",
    "employer branding solution","recruitment automation","ai calling agent recruitment","fresher hiring platform",
    "campus recruitment software","employee branding platform","hiring solution for companies","best recruitment software",
    "recruitment software pricing","hiring platform pricing","recruitment platform comparison"],

  // Employer-relevance lexicon: positive = B2B/employer signal, negative = job-seeker/B2C signal.
  employerPositiveTerms:["employer","employers","recruiter","recruiters","recruitment","hiring","hire","talent acquisition",
    "hr","human resources","company","companies","organization","campus","candidate screening","workforce","onboarding",
    "applicant tracking","interview platform","assessment platform","sourcing","screening","proctoring"],
  employerNegativeTerms:["jobs near me","internship for students","apply for job","salary of","career in","job vacancy",
    "job opening for","fresher jobs","internship stipend","resume format","how to prepare for interview as a candidate",
    "job application status"],

  // Query-pattern library (predefined). Dynamic n-gram mining supplements this.
  patternLibrary:[
    {key:"HOW TO", test:q=>/^how to\b/.test(q)},
    {key:"BEST", test:q=>/\bbest\b/.test(q)},
    {key:"SOFTWARE", test:q=>/\bsoftware\b/.test(q)},
    {key:"PLATFORM", test:q=>/\bplatform\b/.test(q)},
    {key:"SOLUTION", test:q=>/\bsolution(s)?\b/.test(q)},
    {key:"TOOL", test:q=>/\btool(s)?\b/.test(q)},
    {key:"SERVICE", test:q=>/\bservice(s)?\b/.test(q)},
    {key:"PRICING", test:q=>/\bpricing\b/.test(q)},
    {key:"COST", test:q=>/\bcost\b/.test(q)},
    {key:"VS", test:q=>/\bvs\.?\b|versus/.test(q)},
    {key:"ALTERNATIVE", test:q=>/\balternative(s)?\b/.test(q)},
    {key:"FOR COMPANIES", test:q=>/\bfor companies\b/.test(q)},
    {key:"FOR EMPLOYERS", test:q=>/\bfor employers\b/.test(q)},
    {key:"FOR RECRUITERS", test:q=>/\bfor recruiters\b/.test(q)},
    {key:"AT SCALE", test:q=>/\bat scale\b/.test(q)},
    {key:"AI", test:q=>/\bai\b/.test(q)},
    {key:"AUTOMATION", test:q=>/\bautomat/.test(q)},
    {key:"CAMPUS", test:q=>/\bcampus\b/.test(q)},
    {key:"FRESHERS", test:q=>/\bfreshers?\b/.test(q)},
    {key:"HIRING", test:q=>/\bhir(e|ing)\b/.test(q)},
    {key:"RECRUITMENT", test:q=>/\brecruit/.test(q)},
    {key:"TALENT", test:q=>/\btalent\b/.test(q)},
    {key:"EMPLOYER BRANDING", test:q=>/\bemployer brand/.test(q)}
  ],

  // Master Opportunity Score weights (must sum to 1.0) — shown to the user.
  opportunityWeights:{ searchDemand:.20, rankingPotential:.20, employerRelevance:.20, buyingIntent:.15, ctrOpportunity:.10, conversionPotential:.10, contentGap:.05 },

  // Industry-typical CTR-by-position benchmark curve, used ONLY to flag a
  // CTR *gap worth investigating* — never presented as an Unstop-verified number.
  benchmarkCtrByPosition:[[1,0.28],[2,0.15],[3,0.10],[4,0.07],[5,0.06],[6,0.05],[7,0.04],[8,0.035],[9,0.03],[10,0.025],
    [15,0.015],[20,0.01],[30,0.006],[50,0.003],[100,0.001]],

  productFilterList:["EMPLOYER SOLUTIONS","HIRING","EMPLOYER BRANDING","AI RECRUITMENT","ASSESSMENTS","TALENT SOURCING","RECRUITMENT TECHNOLOGY","RECRUITMENT MARKETING"]
};

CONFIG.urlProfiles = {
  "/employers": {
    category:"EMPLOYER SOLUTIONS", urlType:"LANDING PAGE", service:"Employer Solutions",
    problem:"Need scalable hiring; difficulty finding talent; high hiring costs; slow recruitment; fragmented hiring process", solution:"hiring solutions", product:"Employer Solutions",
    icp:["Large enterprises","Startups","SMEs","Recruitment agencies","Staffing companies","BPOs","Internal HR teams"], jobRole:["CHRO","HR Head","Talent Acquisition Head","Recruitment Head","Employer Branding Head"],
