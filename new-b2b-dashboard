function classifyPageBusinessRole(p){
  if(p.ga4 && p.ga4.revenue>0) return "REVENUE CONTRIBUTOR";
  if(p.ga4 && p.ga4.conversions>0) return "LEAD DRIVER";
  const intents = (p.queries||[]).map(q=>classifyIntent(q).intent);
  if(intents.includes("TRANSACTIONAL")) return "COMMERCIAL INTENT";
  if(intents.includes("PRODUCT AWARE")) return "PRODUCT DISCOVERY";
  if(intents.includes("SOLUTION AWARE")) return "SOLUTION DISCOVERY";
  if(intents.includes("PROBLEM AWARE")) return "PROBLEM DISCOVERY";
  if(p.impressions>50) return "TRAFFIC DRIVER";
  return "AWARENESS";
}
