}
function barCell(val,max){ const pct = max>0? Math.min(100, (val/max)*100) : 0; return '<div class="bar"><span style="width:'+pct+'%"></span></div>'; }
let whyCounter = 0;
function whyButtonAndPanel(components, conclusion){
  const id = "why"+(whyCounter++);
  const rows = Object.entries(components).map(([k,v])=>'<div class="comp"><span>'+esc(k)+'</span><span class="mono">'+ (typeof v==="number"? Math.round(v):esc(v)) +'</span></div>').join("");
  return {
