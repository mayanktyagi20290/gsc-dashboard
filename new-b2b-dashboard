function handleGSCFile(file){
  if(typeof XLSX === "undefined"){
    alert("The spreadsheet engine (SheetJS, loaded from cdnjs.cloudflare.com) didn't load, so no file can be read yet.\n\nMost likely cause: this HTML file was opened directly (a file:// URL) and the browser blocked the external script, or an ad-blocker / offline network blocked cdnjs.\n\nFix: host this file (e.g. your GitHub Pages site) and open it over https://, or check your ad-blocker / internet connection, then reload.");
    return;
  }
  const reader = new FileReader();
  reader.onload = function(e){
    // Step 1: parse the spreadsheet. Failures here are genuinely "could not read this file".
    let combined, queryOnly, pageOnly;
    try{
      const data = new Uint8Array(e.target.result);
      const wb = XLSX.read(data, {type:"array"});
      ({combined, queryOnly, pageOnly} = extractRows(wb));
    }catch(err){
      alert("Could not read this file as a spreadsheet: "+err.message+"\n\nMake sure it's the .xlsx/.xls/.csv file exported from Search Console → Performance → Export, not a renamed or corrupted file.");
      return;
    }
    STATE.raw.combined = combined; STATE.raw.queryOnly = queryOnly; STATE.raw.pageOnly = pageOnly;
    if(!combined.length && !queryOnly.length && !pageOnly.length){
      alert("The file was read, but no recognizable Query/Page + Clicks/Impressions columns were found. Please check it's a Search Console Performance export (Queries and/or Pages tabs).");
      return;
    }
    // Step 2: build the dashboard. Failures here are a bug in the dashboard, not a file problem —
    // reported distinctly so it isn't confused with "the file itself is unreadable".
    try{
      bootWithData();
    }catch(err){
      alert("The file was read successfully (found "+(combined.length+queryOnly.length+pageOnly.length)+" rows), but the dashboard hit an error while building the view:\n\n"+err.message+"\n\nOpen the browser console (F12) for details, and check whether every /employers/ URL in your export is covered by CONFIG.urlSeed / CONFIG.urlCategoryHeuristics.");
      console.error(err);
    }
  };
  reader.onerror = function(){ alert("The browser could not read this file from disk. Try re-downloading it from Search Console and uploading again."); };
  reader.readAsArrayBuffer(file);
}

function handleGA4File(file){
  const reader = new FileReader();
  reader.onload = function(e){
    try{
      const data = new Uint8Array(e.target.result);
      const wb = XLSX.read(data, {type:"array"});
      const byPage = parseGA4Workbook(wb);
      if(!byPage){
        document.getElementById("ga4Status").textContent = " — no recognizable Sessions/Conversions/Revenue columns found";
        return;
      }
      STATE.ga4ByPage = byPage;
      document.getElementById("ga4Status").textContent = " — GA4 data loaded (" + Object.keys(byPage).length + " pages)";
      if(document.getElementById("app").style.display === "flex"){ recompute(); renderActiveTab(); }
    }catch(err){
      document.getElementById("ga4Status").textContent = " — error reading GA4 file: "+err.message;
    }
  };
  reader.readAsArrayBuffer(file);
}

