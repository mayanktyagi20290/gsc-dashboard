function initUploadScreen(){
  const dz = document.getElementById("dropzone");
  const fi = document.getElementById("fileInput");
  dz.addEventListener("click", ()=> fi.click());
  fi.addEventListener("change", e=>{ if(e.target.files[0]) handleGSCFile(e.target.files[0]); });
  dz.addEventListener("dragover", e=>{ e.preventDefault(); dz.style.borderColor = "var(--accent)"; });
  dz.addEventListener("dragleave", ()=>{ dz.style.borderColor = "var(--border)"; });
  dz.addEventListener("drop", e=>{
    e.preventDefault(); dz.style.borderColor = "var(--border)";
    if(e.dataTransfer.files[0]) handleGSCFile(e.dataTransfer.files[0]);
  });
  document.getElementById("ga4Btn").addEventListener("click", ()=> document.getElementById("ga4Input").click());
  document.getElementById("ga4Input").addEventListener("change", e=>{ if(e.target.files[0]) handleGA4File(e.target.files[0]); });
  document.getElementById("demoBtn").addEventListener("click", ()=>{ generateSampleData(); bootWithData(); });

  const statusEl = document.getElementById("engineStatus");
  if(typeof XLSX === "undefined"){
    statusEl.innerHTML = '⚠ The spreadsheet engine failed to load from cdnjs.cloudflare.com — uploads won\'t work until this is fixed. If you\'re opening this file directly from disk (file://), host it instead (e.g. GitHub Pages) and open it over https://. Otherwise check your ad-blocker / internet connection and reload.';
    statusEl.style.color = "var(--orange)";
  } else {
    statusEl.textContent = "";
  }
}

document.addEventListener("DOMContentLoaded", initUploadScreen);

