   ------------------------------------------------------------------------- */
RENDERERS.donotpublish = function(container){
  const opp = getAllOpportunityRows();
  const rows = opp.filter(r=>{
    if(r.employerRelevance<35) return true;
    if(r.intent==="INFORMATIONAL" && r.buyingIntent<25 && r.impressions<15) return true;
    if(r.position<=3 && r.ctr>=benchmarkCtr(r.position)*0.8) return true; // already well covered & converting fine
    return false;
  }).map(r=>{
    let reason, alt;
    if(r.employerRelevance<35){ reason="Low Employer relevance — likely a job-seeker/B2C-leaning query"; alt="No action — outside Employer business scope"; }
    else if(r.position<=3){ reason="Already ranking well and converting near/at benchmark — a new page here would just compete with your own winner"; alt="Keep monitoring "+r.path; }
    else { reason="Informational query, low buying intent, low impressions — weak business case for new content"; alt="Cover briefly inside an existing hub page instead of a standalone piece"; }
    return {...r, reason, alt};
  });
  let html = sectionHeader("What Should We NOT Publish?", null, "Knowing what not to build is as important as knowing what to build. These are queries/topics with traffic but low Employer relevance, low business value, or that are already well served by an existing page.");
  if(!rows.length){ container.innerHTML = html + naNote("Nothing currently flagged to avoid for the current filters."); return; }
  html += '<div id="dnpTable"></div>';
  container.innerHTML = html;
  buildTable(document.getElementById("dnpTable"), [
    {key:"query", label:"Topic", render:r=>esc(r.query)},
    {key:"impressions", label:"Impressions", render:r=>fmtNum(r.impressions)},
    {key:"employerRelevance", label:"Business Relevance", render:r=>r.employerRelevance},
    {key:"reason", label:"Reason", render:r=>'<span class="small-muted">'+esc(r.reason)+'</span>'},
