    panel:'<div class="why-panel" id="'+id+'">'+rows+'<div class="comp" style="border-top:1px solid var(--border);margin-top:4px;padding-top:6px;"><b>Therefore</b><b>'+esc(conclusion)+'</b></div></div>'
  };
}

function buildTable(container, columns, rows, opts){
  opts = opts||{};
  let sortKey = opts.defaultSort || null, sortDir = -1;
  function render(){
    let data = rows.slice();
    if(sortKey){
      data.sort((a,b)=>{
        const va=a[sortKey], vb=b[sortKey];
        if(typeof va==="number" && typeof vb==="number") return (va-vb)*sortDir;
        return String(va).localeCompare(String(vb))*sortDir;
      });
    }
    if(opts.limit) data = data.slice(0, opts.limit);
    let html = '<div class="table-wrap"><div class="table-scroll"><table><thead><tr>';
    columns.forEach(c=>{ html += '<th data-key="'+c.key+'">'+esc(c.label)+(sortKey===c.key?(sortDir===1?" ▲":" ▼"):"")+'</th>'; });
    html += '</tr></thead><tbody>';
    if(!data.length){
      html += '<tr><td colspan="'+columns.length+'"><div class="empty-state">No rows match the current filters.</div></td></tr>';
    }
    data.forEach(row=>{
      html += '<tr>';
      columns.forEach(c=>{ html += '<td>'+(c.render? c.render(row) : esc(row[c.key])) +'</td>'; });
      html += '</tr>';
      if(opts.expandable && row.__whyPanel){ html += '<tr><td colspan="'+columns.length+'" style="padding-top:0;">'+row.__whyPanel+'</td></tr>'; }
    });
    html += '</tbody></table></div></div>';
    container.innerHTML = html;
    container.querySelectorAll("th").forEach(th=>{
      th.addEventListener("click", ()=>{
        const k = th.getAttribute("data-key");
        if(sortKey===k) sortDir *= -1; else { sortKey=k; sortDir=-1; }
        render();
      });
    });
  }
  render();
}

function cardKpi(label, value, delta){
  return '<div class="card kpi"><div class="label">'+esc(label)+'</div><div class="value">'+value+'</div>'+(delta?'<div class="delta '+delta.cls+'">'+delta.text+'</div>':'')+'</div>';
}

function sectionHeader(title, hint, desc){
