      ? 'Matched to your team\'s keyword taxonomy'+(r.matchedPhrase? ' via "'+r.matchedPhrase+'"':'')+' ('+conf+'). No Query+Page data in this export — GSC did not directly measure this pairing.'
      : 'No curated-taxonomy match and no Query+Page data in this export — page matched by topic/keyword heuristic ('+conf+'), not measured by GSC.';
    const label = curated ? "✓ taxonomy match" : "≈ inferred";
    return base+' <span class="badge '+(curated?"blue":"gray")+'" title="'+esc(tip)+'">'+label+'</span>';
