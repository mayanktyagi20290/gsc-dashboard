/* -------------------------------------------------------------------------
   2. INGESTION — SheetJS-based parsing of the GSC (and optional GA4) export.
   Flexible header detection so this survives different GSC export variants.
   ------------------------------------------------------------------------- */
const HEADER_SYNONYMS = {
  query: ["query","queries","top queries","search query","search queries"],
  page: ["page","pages","top pages","landing page","landing pages","url"],
  clicks: ["clicks"],
  impressions: ["impressions","impr."],
  ctr: ["ctr","click through rate","clickthrough rate"],
  position: ["position","avg position","average position","avg. position","avg pos"],
  date: ["date","dates","day"],
  country: ["country","countries"],
  device: ["device","devices"],
  // GA4-ish
  sessions: ["sessions","engaged sessions"],
  conversions: ["conversions","key events","goal completions"],
  revenue: ["revenue","total revenue","conversion value"],
  landingPage: ["landing page","landing page path","page path"]
};

function normHeader(h){ return String(h||"").trim().toLowerCase().replace(/\s+/g," "); }

function detectColumns(headerRow){
  const map = {};
  const normed = headerRow.map(normHeader);
  Object.keys(HEADER_SYNONYMS).forEach(key=>{
    for(const syn of HEADER_SYNONYMS[key]){
      const idx = normed.indexOf(syn);
      if(idx!==-1){ map[key]=idx; return; }
    }
  });
  return map;
}

function parseNumber(v){
  if(v===undefined||v===null||v==="") return 0;
  if(typeof v === "number") return v;
  let s = String(v).trim().replace(/,/g,"");
  const isPct = s.includes("%");
  s = s.replace(/%/g,"");
  const n = parseFloat(s);
  if(isNaN(n)) return 0;
  return isPct ? n/100 : n;
}

function sheetToObjects(ws){
  const rows = XLSX.utils.sheet_to_json(ws, {header:1, raw:false, defval:""});
  if(!rows.length) return {cols:{}, rows:[]};
  // find the header row: first row containing at least 2 recognizable headers
  let headerRowIdx = 0, bestMap = {}, bestScore=-1;
  for(let i=0;i<Math.min(rows.length,5);i++){
    const map = detectColumns(rows[i]);
    const score = Object.keys(map).length;
    if(score>bestScore){ bestScore=score; bestMap=map; headerRowIdx=i; }
  }
  if(bestScore<1) return {cols:{}, rows:[]};
  const dataRows = rows.slice(headerRowIdx+1).filter(r=>r.some(c=>c!==""&&c!==undefined&&c!==null));
  return {cols:bestMap, rows:dataRows};
}

function extractRows(workbook){
  // Merge every sheet that yields usable columns. We keep raw rows tagged
  // with which fields were present, so downstream code can pick the richest
  // available combination (query+page > query-only / page-only).
  let combined = []; // has both query & page
  let queryOnly = [];
  let pageOnly = [];
  workbook.SheetNames.forEach(name=>{
    const ws = workbook.Sheets[name];
    const {cols, rows} = sheetToObjects(ws);
    if(!rows.length) return;
    const hasQuery = cols.query!==undefined;
    const hasPage = cols.page!==undefined;
    if(!hasQuery && !hasPage) return; // not a performance sheet we understand (skip Countries/Devices/Dates-only etc. — still could use for context later)
    rows.forEach(r=>{
      const rec = {
        query: hasQuery? String(r[cols.query]||"").trim() : "",
        page: hasPage? String(r[cols.page]||"").trim() : "",
        clicks: cols.clicks!==undefined? parseNumber(r[cols.clicks]) : 0,
        impressions: cols.impressions!==undefined? parseNumber(r[cols.impressions]) : 0,
        ctr: cols.ctr!==undefined? parseNumber(r[cols.ctr]) : null,
        position: cols.position!==undefined? parseNumber(r[cols.position]) : null,
        date: cols.date!==undefined? String(r[cols.date]||"") : "",
        country: cols.country!==undefined? String(r[cols.country]||"") : "",
        device: cols.device!==undefined? String(r[cols.device]||"") : ""
      };
      if(rec.ctr===null) rec.ctr = rec.impressions>0? rec.clicks/rec.impressions : 0;
      if(rec.position===null) rec.position = 0;
      if(!rec.query && !rec.page) return;
      if(hasQuery && hasPage) combined.push(rec);
      else if(hasQuery) queryOnly.push(rec);
      else if(hasPage) pageOnly.push(rec);
    });
  });
  return {combined, queryOnly, pageOnly};
}

function parseGA4Workbook(workbook){
  // Best-effort GA4 export parser: looks for a sheet with a landing-page-like
  // column plus sessions/conversions/revenue. Returns a lookup by page path,
  // or null if nothing usable was found (module then shows "REQUIRES GA4").
  let byPage = {};
  let found = false;
  workbook.SheetNames.forEach(name=>{
    const ws = workbook.Sheets[name];
    const {cols, rows} = sheetToObjects(ws);
    const pageCol = cols.landingPage!==undefined? cols.landingPage : cols.page;
    if(pageCol===undefined || (cols.sessions===undefined && cols.conversions===undefined && cols.revenue===undefined)) return;
    found = true;
    rows.forEach(r=>{
      const page = String(r[pageCol]||"").trim();
      if(!page) return;
      byPage[page] = byPage[page] || {sessions:0, conversions:0, revenue:0};
      if(cols.sessions!==undefined) byPage[page].sessions += parseNumber(r[cols.sessions]);
      if(cols.conversions!==undefined) byPage[page].conversions += parseNumber(r[cols.conversions]);
      if(cols.revenue!==undefined) byPage[page].revenue += parseNumber(r[cols.revenue]);
    });
  });
  return found ? byPage : null;
}


