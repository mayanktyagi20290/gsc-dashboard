/* -------------------------------------------------------------------------
   6. OPPORTUNITY ROW BUILDER (shared by Overview / Query Intelligence /
      Top10 Radar / Top3 Radar / Buying Intent / Landing Page Detector)
   ------------------------------------------------------------------------- */
function hasStrongDedicatedPage(urlType){
  return ["PRODUCT","SOLUTION","LANDING PAGE","USE CASE"].includes(urlType);
}

function recommendAction(r, isCannibal){
  if(isCannibal) return "MERGE";
  if(r.position<=10 && r.impressions>=8 && r.__ctrOpp>=45) return "IMPROVE CTR";
  if(r.position>3 && r.position<=10) return "PUSH TO TOP 3";
  if(r.position>10 && r.position<=20){
    return r.impressions>=15 ? "PUSH TO TOP 10" : "ADD INTERNAL LINKS";
  }
  if(r.position>20 && r.position<=30 && r.impressions>=10) return "PUSH TO TOP 10";
  if(!hasStrongDedicatedPage(r.urlType) && r.buyingIntent>=55) return "CREATE LANDING PAGE";
  if(r.intent==="INFORMATIONAL") return "CREATE SUPPORTING CONTENT";
  if(r.position<=3) return "IMPROVE CTR";
  return "UPDATE PAGE";
}

function buildOpportunityRow(r, maxImpressions, cannibalQuerySet){
  const searchDemand = searchDemandScore(r.impressions, maxImpressions);
  const ranking = rankingPotential(r.position);
  const ctrOpp = ctrOpportunityScore(r.position, r.ctr, r.impressions);
  const hasPage = hasStrongDedicatedPage(r.urlType);
  const gap = contentGapScore(hasPage);
  const ga4 = STATE.ga4ByPage ? (STATE.ga4ByPage[r.page]||STATE.ga4ByPage[r.path]) : null;
  const conversionPotential = ga4 ? Math.min(100, Math.round((ga4.conversions/Math.max(ga4.sessions,1))*1000)) : r.businessValue;
  const components = { "Search Demand (20%)":searchDemand, "Ranking Potential (20%)":ranking, "Employer Relevance (20%)":r.employerRelevance,
    "Buying Intent (15%)":r.buyingIntent, "CTR Opportunity (10%)":ctrOpp, "Conversion Potential (10%)": conversionPotential + (ga4?"":" (estimate)"),
    "Content Gap (5%)":gap };
  const score = masterOpportunityScore({searchDemand, rankingPotential:ranking, employerRelevance:r.employerRelevance,
    buyingIntent:r.buyingIntent, ctrOpportunity:ctrOpp, conversionPotential: typeof conversionPotential==="number"?conversionPotential:r.businessValue, contentGap:gap});
  const isCannibal = cannibalQuerySet && cannibalQuerySet.has(r.query);
  const rTmp = {...r, __ctrOpp:ctrOpp};
  const action = recommendAction(rTmp, isCannibal);
  return {...r, opportunityScore:score, priority:priorityFromScore(score), action, components, ctrOppScore:ctrOpp, hasDedicatedPage:hasPage, ga4Conversion: ga4? true:false};
}

function whyText(row){
  const bits = [];
  bits.push(row.impressions+" impressions, "+row.clicks+" clicks (7-period window in export)");
  bits.push("Position "+row.position.toFixed(1)+" ("+ (row.position<=3?"Top 3": row.position<=10?"Top 10": row.position<=20?"Striking Distance": row.position<=30?"Page 1 Opportunity":"Long Term") +")");
  bits.push("Intent: "+row.intent+" · Buying Intent "+row.buyingIntent+"/100 · Employer Relevance "+row.employerRelevance+"/100");
  if(!row.hasDedicatedPage) bits.push("No strong dedicated page currently targets this ("+row.urlType+")");
  if(row.ctrOppScore>=40) bits.push("CTR below the industry-typical benchmark for this position — investigate, not yet diagnosed");
  return bits;
}


