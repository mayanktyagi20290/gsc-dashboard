RENDERERS.decay = function(container){
  const d = STATE.derived;
  const withTrend = d.pageAgg.filter(p=>p.trend);
  let html = sectionHeader("Employer Content Decay", null, "Compares the first half vs second half of your export's date range per page. Requires the Date dimension in the export — without it, decay cannot be measured and is shown as unavailable rather than guessed.");
  if(!withTrend.length){ container.innerHTML = html + naNote("Your export has no Date dimension (or too narrow a range) — content decay requires it. Re-export from GSC with Date included."); return; }
  html += '<div id="decayTable"></div>';
  container.innerHTML = html;
  const rows = withTrend.map(p=>{
    const delta = p.trend.late - p.trend.early;
    let cls = "STABLE", action = "MONITOR";
    if(delta<=-1){ cls="GROWING"; action="none — performing well"; }
    else if(delta<=1){ cls="STABLE"; action="MONITOR"; }
    else if(delta<=5){ cls="EARLY DECLINE"; action="ADD INTERNAL LINKS"; }
    else if(delta<=15){ cls="SIGNIFICANT DECLINE"; action = p.impressions>20? "REFRESH / EXPAND" : "REWRITE"; }
    else { cls="CRITICAL DECAY"; action = p.impressions>10? "REWRITE / REPOSITION" : "RETIRE / MERGE"; }
    return {...p, delta, cls, action};
  }).sort((a,b)=>b.delta-a.delta);
  buildTable(document.getElementById("decayTable"), [
    {key:"path", label:"URL", render:r=>urlCellRow(r)},
    {key:"impressions", label:"Impressions", render:r=>fmtNum(r.impressions)},
    {key:"delta", label:"Position Change", render:r=>(r.delta<=0? '<span style="color:var(--green)">▲ '+Math.abs(r.delta).toFixed(1)+'</span>':'<span style="color:var(--red)">▼ '+r.delta.toFixed(1)+'</span>')},
    {key:"cls", label:"Status", render:r=>'<span class="badge '+(r.cls==="CRITICAL DECAY"?"p0":r.cls==="SIGNIFICANT DECLINE"?"p1":r.cls==="EARLY DECLINE"?"p2":r.cls==="GROWING"?"green":"gray")+'">'+r.cls+'</span>'},
    {key:"action", label:"Recommended Action"}
  ], rows, {defaultSort:"delta"});
};

