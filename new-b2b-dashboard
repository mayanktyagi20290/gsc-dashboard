RENDERERS.gaps = function(container){
  const d = STATE.derived;
  const candidates = d.clusters.filter(c=>!c.urls.some(u=>hasStrongDedicatedPage(enrichUrl(u).type)) && c.impressions>=5);
  function gapType(c){
    const intents = c.members.map(m=>m.intent);
    if(intents.includes("PRODUCT AWARE")) return "PRODUCT GAP";
    if(intents.includes("TRANSACTIONAL") || intents.includes("COMMERCIAL INVESTIGATION")) return c.members.some(m=>/\bvs\b/.test(m.query))? "COMPARISON GAP" : "SOLUTION GAP";
    if(intents.includes("SOLUTION AWARE")) return "SOLUTION GAP";
    if(intents.includes("PROBLEM AWARE")) return "USE CASE GAP";
    return "INFORMATION GAP";
  }
  const priorityOrder = {"PRODUCT GAP":0,"SOLUTION GAP":1,"USE CASE GAP":2,"COMPARISON GAP":3,"INFORMATION GAP":4};
  const rows = candidates.map(c=>({...c, gapType:gapType(c)})).sort((a,b)=> (priorityOrder[a.gapType]-priorityOrder[b.gapType]) || (b.impressions-a.impressions));
  let html = sectionHeader("Employer Content Gaps", null, "Topics with real search demand and Employer relevance but no strong dedicated page. Product and Solution gaps are prioritized above generic informational gaps, per the spec's ranking rule.");
  if(!rows.length){ container.innerHTML = html + naNote("No content gaps detected for the current filters."); return; }
  html += '<div id="gapTable"></div>';
  container.innerHTML = html;
  buildTable(document.getElementById("gapTable"), [
    {key:"gapType", label:"Category", render:r=>'<span class="badge '+(r.gapType==="PRODUCT GAP"||r.gapType==="SOLUTION GAP"?"p0":"gray")+'">'+r.gapType+'</span>'},
    {key:"label", label:"Topic", render:r=>'<b>'+esc(r.label)+'</b>'},
    {key:"impressions", label:"Impressions", render:r=>fmtNum(r.impressions)},
    {key:"queryCount", label:"Queries"},
    {key:"category", label:"Business Category", render:r=>esc(r.category)},
    {key:"businessValue", label:"Business Value", render:r=>r.businessValue}
  ], rows, {defaultSort:"impressions"});
};

