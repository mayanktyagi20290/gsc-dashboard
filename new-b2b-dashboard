function getAllOpportunityRows(){
  const d = STATE.derived;
  const cannibalQuerySet = new Set(d.cannibalization.filter(c=>c.confidence!=="LOW").map(c=>c.query));
  // primary row per query = the page with most impressions for that query
  const byQuery = new Map();
  d.qpAgg.forEach(r=>{
    const cur = byQuery.get(r.query);
    if(!cur || r.impressions>cur.impressions) byQuery.set(r.query, r);
  });
  return Array.from(byQuery.values()).map(r=>buildOpportunityRow(r, d.maxImpressions, cannibalQuerySet));
}

