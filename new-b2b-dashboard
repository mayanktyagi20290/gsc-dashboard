   3. CLASSIFICATION & SCORING ENGINES
   ------------------------------------------------------------------------- */
const STOPWORDS = new Set(["a","an","the","for","and","or","of","to","in","on","with","is","are","what","which",
  "how","do","does","i","my","your","you","we","best","top","vs","near","me","by","at","as","this","that"]);

function pathFromUrl(u){
  if(!u) return "";
  try{
    let s = String(u).trim();
    if(!/^https?:\/\//i.test(s)) s = "https://x"+ (s.startsWith("/")?s:"/"+s);
    const m = new URL(s);
    let p = m.pathname.replace(/\/+$/,"");
    return p || "/";
  }catch(e){
    let p = String(u).split("?")[0].replace(/\/+$/,"");
    return p || "/";
  }
}

function isEmployerPath(path, includeSupporting){
  const p = path.toLowerCase();
  const isEmp = CONFIG.employerPathPrefixes.some(pref=>p===pref || p.startsWith(pref+"/") || p===pref);
  if(!isEmp) return false;
  if(includeSupporting) return true;
  return !CONFIG.nonEmployerPathHints.some(hint=>p.includes(hint));
}

function classifyUrl(path){
  const profile = CONFIG.urlProfiles[path];
  if(profile) return {type:profile.urlType, category:profile.category, source:"profile"};
  const p = path.toLowerCase();
  let type = "OTHER";
  for(const rule of CONFIG.urlTypeHeuristics){ if(rule.test(p)){ type = rule.type; break; } }
  let category = "EMPLOYER SOLUTIONS";
  for(const rule of CONFIG.urlCategoryHeuristics){ if(rule.test(p)){ category = rule.category; break; } }
  return {type, category, source:"heuristic"};
}

function classifyQueryCategory(query){
  // Same keyword roots as CONFIG.urlCategoryHeuristics, applied to query text
  // instead of a URL path — used as a last-resort fallback in inferPageForQuery
  // when no curated taxonomy match exists.
  const q = (query||"").toLowerCase();
  for(const rule of CONFIG.urlCategoryHeuristics){ if(rule.test(q)) return rule.category; }
  return null;
}

/* ---- Curated keyword matching against the team's real taxonomy (CONFIG.urlProfiles) ----
   Field priority runs from strongest buying signal (BOFU/Product/Commercial) down to
   weakest (TOFU/Informational), so the first hit found is also the most decisive one. */
const STAGE_FIELDS = [
  ["bofu","BOFU"], ["productAware","PRODUCT AWARE"], ["bucketProduct","PRODUCT"], ["productSearch","PRODUCT"],
  ["bucketCI","COMMERCIAL"], ["kwCommercial","COMMERCIAL"],
  ["solutionAware","SOLUTION AWARE"], ["bucketSolution","SOLUTION"], ["kwSolution","SOLUTION"], ["solutionSearch","SOLUTION"],
  ["mofu","MOFU"],
  ["problemAware","PROBLEM AWARE"], ["bucketProblem","PROBLEM"], ["kwProblem","PROBLEM"], ["problemSearch","PROBLEM"],
  ["kwComparison","COMPARISON"], ["bucketCompetitor","COMPETITOR"], ["kwUseCase","USE CASE"],
  ["tofu","TOFU"], ["informational","INFORMATIONAL"]
];
const STAGE_TO_INTENT = {
  BOFU:"PRODUCT AWARE", "PRODUCT AWARE":"PRODUCT AWARE", PRODUCT:"PRODUCT AWARE",
  COMMERCIAL:"COMMERCIAL INVESTIGATION", COMPARISON:"COMMERCIAL INVESTIGATION", COMPETITOR:"COMMERCIAL INVESTIGATION",
  "SOLUTION AWARE":"SOLUTION AWARE", SOLUTION:"SOLUTION AWARE", MOFU:"SOLUTION AWARE", "USE CASE":"SOLUTION AWARE",
  "PROBLEM AWARE":"PROBLEM AWARE", PROBLEM:"PROBLEM AWARE",
  TOFU:"INFORMATIONAL", INFORMATIONAL:"INFORMATIONAL"
};

function curatedMatchForQuery(query, restrictToPath){
  const ql = (query||"").toLowerCase().trim();
  if(!ql) return null;
  const paths = restrictToPath ? [restrictToPath] : Object.keys(CONFIG.urlProfiles);
  // Pass 1 — exact phrase match, in stage-priority order (first hit wins).
  for(const [key,stage] of STAGE_FIELDS){
    for(const path of paths){
      const prof = CONFIG.urlProfiles[path]; if(!prof) continue;
      for(const phrase of (prof[key]||[])){
        if(phrase.toLowerCase().trim()===ql) return {path, stage, phrase, confidence:"CURATED-EXACT"};
      }
    }
  }
  // Pass 2 — fuzzy substring match (longest curated phrase wins), same priority order.
  let best = null, bestLen = 0;
  for(const [key,stage] of STAGE_FIELDS){
    for(const path of paths){
      const prof = CONFIG.urlProfiles[path]; if(!prof) continue;
      for(const phrase of (prof[key]||[])){
        const pl = phrase.toLowerCase().trim();
        if(pl.length<6) continue;
        if((ql.includes(pl) || pl.includes(ql)) && pl.length>bestLen){ bestLen=pl.length; best={path, stage, phrase, confidence:"CURATED-FUZZY"}; }
      }
    }
  }
  return best;
}

function inferPageForQuery(query, pagesPool){
  // pagesPool: array of {page, path, category, urlType, impressions} — the
  // real Pages-sheet rows for the current scope. Returns {page, path, category,
  // urlType, confidence, stage?, matchedPhrase?}. This NEVER claims GSC measured
  // this query on this page — callers must label it "inferred" wherever shown.
  if(!pagesPool.length) return null;

  // Tier 1 — curated match against the team's real keyword taxonomy.
  const curated = curatedMatchForQuery(query);
  if(curated){
    const onPage = pagesPool.find(pp=>pp.path===curated.path);
    if(onPage) return {page:onPage.page, path:onPage.path, category:onPage.category, urlType:onPage.urlType,
      confidence:curated.confidence, stage:curated.stage, matchedPhrase:curated.phrase};
    const prof = CONFIG.urlProfiles[curated.path];
    if(prof) return {page:curated.path, path:curated.path, category:prof.category, urlType:prof.urlType,
      confidence:curated.confidence, stage:curated.stage, matchedPhrase:curated.phrase};
  }

  // Tier 2 — query shares a meaningful token with the page's own URL slug.
  const qTokens = tokenSet(query);
  let best = null, bestScore = -1;
  pagesPool.forEach(p=>{
    const slugTokens = tokenSet(p.path.replace(/[\/-]/g," "));
    const overlap = [...qTokens].filter(t=>slugTokens.has(t)).length;
    if(overlap>bestScore){ bestScore = overlap; best = p; }
  });
  if(best && bestScore>=1) return {page:best.page, path:best.path, category:best.category, urlType:best.urlType, confidence:"HEURISTIC-HIGH"};

  // Tier 3 — same business category, pick the highest-impression page in it.
  const qCategory = classifyQueryCategory(query);
  if(qCategory){
    const inCat = pagesPool.filter(p=>p.category===qCategory).sort((a,b)=>b.impressions-a.impressions);
    if(inCat.length) return {page:inCat[0].page, path:inCat[0].path, category:inCat[0].category, urlType:inCat[0].urlType, confidence:"HEURISTIC-MEDIUM"};
  }

  // Tier 4 — fall back to the /employers hub if present, else the single highest-impression page.
  const hub = pagesPool.find(p=>p.path.replace(/\/+$/,"")==="/employers");
  const fallback = hub || pagesPool.slice().sort((a,b)=>b.impressions-a.impressions)[0];
  return {page:fallback.page, path:fallback.path, category:fallback.category, urlType:fallback.urlType, confidence:"HEURISTIC-LOW"};
}

function isBrandedQuery(q){
  const ql = (q||"").toLowerCase();
  return CONFIG.brandTerms.some(b=>ql.includes(b));
}

function classifyIntent(query){
  const q = (" "+(query||"").toLowerCase()+" ");
  let scores = {};
  Object.keys(CONFIG.intentLexicon).forEach(intent=>{
    const def = CONFIG.intentLexicon[intent];
    let hits = 0;
    def.terms.forEach(t=>{ if(q.includes(t)) hits++; });
    scores[intent] = hits>0 ? def.base + (hits-1)*4 : 0;
  });
  if(isBrandedQuery(query)) scores["NAVIGATIONAL"] = Math.max(scores["NAVIGATIONAL"]||0, 70);
  let best = "INFORMATIONAL", bestScore = -1;
  Object.keys(scores).forEach(k=>{ if(scores[k]>bestScore){ bestScore=scores[k]; best=k; } });
  if(bestScore<=0){ best = "INFORMATIONAL"; bestScore = CONFIG.intentLexicon.INFORMATIONAL.base*0.5; }
  return {intent:best, intentScore:Math.min(100,bestScore)};
}

function buyingIntentScore(query, intentScore){
  const q = (" "+(query||"").toLowerCase()+" ");
  let score = intentScore;
  CONFIG.strongBuyingIntentPhrases.forEach(phrase=>{
    if(q.includes(" "+phrase+" ") || q.includes(phrase)) score += 15;
  });
  if(isBrandedQuery(query)) score = Math.min(score, 35); // branded/navigational rarely a real buying signal for SEO growth purposes
  return Math.max(0, Math.min(100, Math.round(score)));
}

function employerRelevanceScore(query, urlCategory){
  const q = (" "+(query||"").toLowerCase()+" ");
  let score = 40; // neutral baseline since query already ranks on an /employers/ page
  CONFIG.employerPositiveTerms.forEach(t=>{ if(q.includes(t)) score += 8; });
  CONFIG.employerNegativeTerms.forEach(t=>{ if(q.includes(t)) score -= 30; });
  if(urlCategory && urlCategory!=="EMPLOYER SOLUTIONS") score += 10;
  return Math.max(0, Math.min(100, Math.round(score)));
}

function businessValueScore(buyingIntent, employerRelevance, category){
  const highValueCats = ["AI RECRUITMENT","ASSESSMENTS","HIRING","RECRUITMENT AUTOMATION","AI CALLING","TALENT SOURCING","LATERAL HIRING","BULK HIRING","CAMPUS HIRING"];
  const catWeight = highValueCats.includes(category) ? 85 : 60;
  const score = 0.5*buyingIntent + 0.3*employerRelevance + 0.2*catWeight;
  return Math.max(0, Math.min(100, Math.round(score)));
}

function benchmarkCtr(position){
  const curve = CONFIG.benchmarkCtrByPosition;
  if(position<=curve[0][0]) return curve[0][1];
  for(let i=0;i<curve.length-1;i++){
    const [p1,c1]=curve[i], [p2,c2]=curve[i+1];
    if(position>=p1 && position<=p2){
      const t = (position-p1)/(p2-p1);
      return c1 + t*(c2-c1);
    }
  }
  return curve[curve.length-1][1];
}

function rankingPotential(position){
  // Peaks around position 5-8 (biggest realistic room to move into top3/top10),
  // tapers for #1-2 (little room) and collapses for very deep positions.
  if(position<=0) return 0;
  if(position<=2) return 35;
  if(position<=3) return 55;
  if(position<=10) return 100 - Math.abs(position-6)*6;
  if(position<=20) return 70 - (position-10)*4;
  if(position<=30) return 30 - (position-20)*2;
  return Math.max(3, 10 - (position-30)*0.15);
}

function searchDemandScore(impressions, maxImpressions){
  if(maxImpressions<=0) return 0;
  const v = Math.log10(impressions+1) / Math.log10(maxImpressions+1);
  return Math.round(Math.max(0,Math.min(1,v))*100);
}

function ctrOpportunityScore(position, ctr, impressions){
  const bench = benchmarkCtr(position);
  if(bench<=0 || impressions<3) return 0;
  const gap = (bench - ctr) / bench; // fraction below benchmark
  const impFactor = Math.min(1, Math.log10(impressions+1)/Math.log10(200));
  return Math.round(Math.max(0, Math.min(1, gap)) * impFactor * 100);
}

function contentGapScore(hasStrongDedicatedPage){
  return hasStrongDedicatedPage ? 15 : 90;
}

function masterOpportunityScore(components){
  const w = CONFIG.opportunityWeights;
  const total = components.searchDemand*w.searchDemand + components.rankingPotential*w.rankingPotential +
    components.employerRelevance*w.employerRelevance + components.buyingIntent*w.buyingIntent +
    components.ctrOpportunity*w.ctrOpportunity + components.conversionPotential*w.conversionPotential +
    components.contentGap*w.contentGap;
  return Math.round(total);
}

function priorityFromScore(score){
  if(score>=80) return "P0";
  if(score>=60) return "P1";
  if(score>=40) return "P2";
  return "IGNORE";
}

function matchPatterns(query){
  const q = " "+(query||"").toLowerCase()+" ";
  return CONFIG.patternLibrary.filter(p=>p.test(q)).map(p=>p.key);
}

function mineDynamicPatterns(queries, predefinedKeysSet){
  // n-gram (bigram+trigram) frequency mining over tokens not already covered
  // by the predefined pattern library, to surface *undiscovered* patterns.
  const freq = {};
  queries.forEach(q=>{
    const tokens = (q||"").toLowerCase().split(/\s+/).filter(t=>t && !STOPWORDS.has(t));
    for(let n=2;n<=3;n++){
      for(let i=0;i+n<=tokens.length;i++){
        const gram = tokens.slice(i,i+n).join(" ");
        if(gram.length<5) continue;
        freq[gram] = (freq[gram]||0)+1;
      }
    }
  });
  return Object.entries(freq).filter(([g,c])=>c>=3).sort((a,b)=>b[1]-a[1]).slice(0,25).map(([g,c])=>({pattern:g.toUpperCase(), count:c}));
}

function tokenSet(str){
  return new Set((str||"").toLowerCase().split(/\s+/).filter(t=>t && !STOPWORDS.has(t) && t.length>2));
}
function jaccard(a,b){
  const inter = new Set([...a].filter(x=>b.has(x))).size;
  const union = new Set([...a,...b]).size;
  return union===0?0:inter/union;
}

function clusterQueries(rows, threshold){
  // rows: aggregated per-query records {query, impressions, clicks, position, ...}
  threshold = threshold || 0.34;
  const items = rows.map(r=>({...r, tokens:tokenSet(r.query)}));
  items.sort((a,b)=>b.impressions-a.impressions);
  const clusters = [];
  const used = new Array(items.length).fill(false);
  for(let i=0;i<items.length;i++){
    if(used[i]) continue;
    const seed = items[i];
    const members = [seed];
    used[i]=true;
    for(let j=i+1;j<items.length;j++){
      if(used[j]) continue;
      if(jaccard(seed.tokens, items[j].tokens) >= threshold){
        members.push(items[j]); used[j]=true;
      }
    }
    clusters.push(members);
  }
  return clusters;
}

function clusterLabel(members){
  const freq = {};
  members.forEach(m=>{ m.tokens.forEach(t=>{ freq[t]=(freq[t]||0)+1; }); });
  const top = Object.entries(freq).sort((a,b)=>b[1]-a[1]).slice(0,3).map(x=>x[0]);
  return top.join(" ") || members[0].query;
}


/* -------------------------------------------------------------------------
   4. PIPELINE — turns raw parsed rows into every enriched view the tabs need.
   Recomputed whenever a global filter changes.
   ------------------------------------------------------------------------- */
const STATE = {
  raw: { combined:[], queryOnly:[], pageOnly:[] },
  ga4ByPage: null,
  filters: { includeSupporting:false, product:"ALL", includeBranded:false, minImpressions:1 },
  derived: null
};

function groupSum(rows, keyFn){
  const map = new Map();
  rows.forEach(r=>{
    const k = keyFn(r);
    if(!map.has(k)) map.set(k, {clicks:0, impressions:0, posWeighted:0, dates:[]});
    const g = map.get(k);
    g.clicks += r.clicks; g.impressions += r.impressions;
    g.posWeighted += (r.position||0) * Math.max(r.impressions,1);
    if(r.date) g.dates.push(r.date);
  });
  return map;
}

function enrichUrl(page){
  const path = pathFromUrl(page);
  const cls = classifyUrl(path);
  const profile = CONFIG.urlProfiles[path];
  const biz = CONFIG.businessMap[cls.category] || CONFIG.businessMap["EMPLOYER SOLUTIONS"];
  // Page-specific problem/solution/product (from the real taxonomy file) beats
  // the generic category-level fallback whenever we have it.
  const merged = profile ? { problem:profile.problem, solution:profile.solution, product:profile.product, outcome:biz.outcome,
    icp:profile.icp||[], jobRole:profile.jobRole||[], service:profile.service } : { ...biz, icp:[], jobRole:[] };
  return {path, urlType:cls.type, category:cls.category, ...merged};
}

function enrichQuery(query, urlCategory, curatedHint){
  let intent, intentScore;
  if(curatedHint && STAGE_TO_INTENT[curatedHint.stage]){
    intent = STAGE_TO_INTENT[curatedHint.stage];
    intentScore = curatedHint.confidence==="CURATED-EXACT" ? 90 : 74;
  } else {
    ({intent, intentScore} = classifyIntent(query));
  }
  let buying = buyingIntentScore(query, intentScore);
  if(curatedHint) buying = Math.min(100, buying + 8); // curated (team-defined) match is itself a relevance/intent signal
  const relevance = employerRelevanceScore(query, urlCategory);
  const value = businessValueScore(buying, relevance, urlCategory);
  const patterns = matchPatterns(query);
  return {intent, buyingIntent:buying, employerRelevance:relevance, businessValue:value, patterns, branded:isBrandedQuery(query),
    curatedMatch: curatedHint ? {stage:curatedHint.stage, phrase:curatedHint.phrase||curatedHint.matchedPhrase, confidence:curatedHint.confidence} : null};
}

function trendSplit(rows){
  // Splits rows with a date field into two halves by median date and returns
  // {early, late} weighted-average positions, or null if no usable dates.
  const withDate = rows.filter(r=>r.date);
  if(withDate.length < 4) return null;
  const dates = withDate.map(r=>r.date).sort();
  const mid = dates[Math.floor(dates.length/2)];
  const early = withDate.filter(r=>r.date < mid);
  const late = withDate.filter(r=>r.date >= mid);
  const wavg = arr => { const imp = arr.reduce((s,r)=>s+Math.max(r.impressions,1),0); return arr.reduce((s,r)=>s+(r.position||0)*Math.max(r.impressions,1),0)/ (imp||1); };
  if(!early.length || !late.length) return null;
  return {early: wavg(early), late: wavg(late)};
}

function recompute(){
  const f = STATE.filters;
  const maxImpPool = [];

  // ---- Filter to Employer scope, honoring the include-supporting toggle ----
  function keep(page){ return page && isEmployerPath(pathFromUrl(page), f.includeSupporting); }

  const combined = STATE.raw.combined.filter(r=> keep(r.page) && (f.includeBranded || !isBrandedQuery(r.query)));
  const queryOnly = STATE.raw.queryOnly.filter(r=> (f.includeBranded || !isBrandedQuery(r.query)));
  const pageOnly = STATE.raw.pageOnly.filter(r=> keep(r.page));
  const combinedAvailable = combined.length>0;

  // ---- Query+Page aggregation (the richest view) ----
  const qpMap = groupSum(combined, r=> r.query+""+r.page);
  let qpAgg = [];
  qpMap.forEach((g,k)=>{
    const [query,page] = k.split("");
    const position = g.posWeighted / Math.max(g.impressions,1);
    const urlInfo = enrichUrl(page);
    if(f.product!=="ALL" && urlInfo.category!==f.product) return;
    // Real GSC-attributed (query, page) pair — still worth checking whether this
    // specific query matches THIS page's own curated taxonomy, to sharpen intent.
    const curatedHint = curatedMatchForQuery(query, urlInfo.path);
    const qInfo = enrichQuery(query, urlInfo.category, curatedHint);
    const ctr = g.impressions>0 ? g.clicks/g.impressions : 0;
    qpAgg.push({query, page, path:urlInfo.path, clicks:g.clicks, impressions:g.impressions, ctr, position,
      urlType:urlInfo.type, category:urlInfo.category, problem:urlInfo.problem, solution:urlInfo.solution,
      product:urlInfo.product, outcome:urlInfo.outcome, icp:urlInfo.icp||[], jobRole:urlInfo.jobRole||[],
      dates:g.dates, inferred:false, matchConfidence:"EXACT",
      ...qInfo});
    maxImpPool.push(g.impressions);
  });

  // ---- INFERRED fallback: standard GSC exports never include Query+Page
  // combined rows (Google does not offer that export from the UI), so when
  // there is no real combined data we approximate a target page per query by
  // topic/keyword match against the real Pages sheet. Every such row is
  // tagged inferred:true with a confidence — callers must show "≈ inferred".
  if(!combinedAvailable && queryOnly.length){
    const pagePool = groupSum(pageOnly, r=>r.page);
    const pagesPool = [];
    pagePool.forEach((g,page)=>{
      const urlInfo = enrichUrl(page);
      if(f.product!=="ALL" && urlInfo.category!==f.product) return;
      pagesPool.push({page, path:urlInfo.path, category:urlInfo.category, urlType:urlInfo.type, impressions:g.impressions});
    });
    const qMap = groupSum(queryOnly, r=>r.query);
    qMap.forEach((g,query)=>{
      const match = inferPageForQuery(query, pagesPool);
      if(!match) return;
      if(f.product!=="ALL" && match.category!==f.product) return;
      const position = g.posWeighted / Math.max(g.impressions,1);
      const curatedHint = match.stage ? {stage:match.stage, phrase:match.matchedPhrase, confidence:match.confidence} : null;
      const qInfo = enrichQuery(query, match.category, curatedHint);
      const ctr = g.impressions>0 ? g.clicks/g.impressions : 0;
      const matchedProfile = CONFIG.urlProfiles[match.path];
      const biz = CONFIG.businessMap[match.category] || CONFIG.businessMap["EMPLOYER SOLUTIONS"];
      qpAgg.push({query, page:match.page, path:match.path, clicks:g.clicks, impressions:g.impressions, ctr, position,
        urlType:match.urlType, category:match.category,
        problem: matchedProfile? matchedProfile.problem : biz.problem,
        solution: matchedProfile? matchedProfile.solution : biz.solution,
        product: matchedProfile? matchedProfile.product : biz.product,
        outcome: biz.outcome, icp: matchedProfile? matchedProfile.icp : [], jobRole: matchedProfile? matchedProfile.jobRole : [],
        dates:g.dates, inferred:true, matchConfidence:match.confidence, matchedPhrase:match.matchedPhrase||null,
        ...qInfo});
      maxImpPool.push(g.impressions);
    });
  }

  qpAgg = qpAgg.filter(r=>r.impressions>=f.minImpressions);
  const maxImpressions = Math.max(1, ...maxImpPool);

  // ---- By-query grouping (for cannibalization + primary-page selection) ----
  const byQueryMap = new Map();
  qpAgg.forEach(r=>{
    if(!byQueryMap.has(r.query)) byQueryMap.set(r.query, []);
    byQueryMap.get(r.query).push(r);
  });

  // ---- By-page grouping ----
  const byPageMap = new Map();
  qpAgg.forEach(r=>{
    if(!byPageMap.has(r.page)) byPageMap.set(r.page, []);
    byPageMap.get(r.page).push(r);
  });
  let pageAgg = [];
  byPageMap.forEach((rows,page)=>{
    const clicks = rows.reduce((s,r)=>s+r.clicks,0);
    const impressions = rows.reduce((s,r)=>s+r.impressions,0);
    const position = rows.reduce((s,r)=>s+r.position*Math.max(r.impressions,1),0)/Math.max(impressions,1);
    const ctr = impressions>0? clicks/impressions:0;
    const urlInfo = enrichUrl(page);
    const rawRowsForPage = combined.filter(r=>r.page===page);
    const trend = trendSplit(rawRowsForPage);
    const ga4 = STATE.ga4ByPage ? (STATE.ga4ByPage[page] || STATE.ga4ByPage[urlInfo.path]) : null;
    pageAgg.push({page, path:urlInfo.path, urlType:urlInfo.type, category:urlInfo.category, clicks, impressions, ctr,
      position, queryCount:rows.length, queries:rows.map(r=>r.query), trend, ga4: ga4||null,
      problem:urlInfo.problem, solution:urlInfo.solution, product:urlInfo.product, outcome:urlInfo.outcome,
      icp:urlInfo.icp||[], jobRole:urlInfo.jobRole||[]});
  });

  // Fallback page-only aggregation when no combined data exists at all (pure single-dimension export)
  if(pageAgg.length===0 && pageOnly.length){
    const map = groupSum(pageOnly, r=>r.page);
    map.forEach((g,page)=>{
      const urlInfo = enrichUrl(page);
      if(f.product!=="ALL" && urlInfo.category!==f.product) return;
      const position = g.posWeighted/Math.max(g.impressions,1);
      pageAgg.push({page, path:urlInfo.path, urlType:urlInfo.type, category:urlInfo.category, clicks:g.clicks,
        impressions:g.impressions, ctr: g.impressions>0? g.clicks/g.impressions:0, position, queryCount:0, queries:[],
        trend:null, ga4:null, problem:urlInfo.problem, solution:urlInfo.solution, product:urlInfo.product,
        outcome:urlInfo.outcome, icp:urlInfo.icp||[], jobRole:urlInfo.jobRole||[]});
    });
  }

  // ---- Cannibalization detection (query-level, requires combined data) ----
  let cannibalization = [];
  byQueryMap.forEach((rows,query)=>{
    if(rows.length<2) return;
    const sorted = [...rows].sort((a,b)=>a.position-b.position);
    const [A,B] = sorted;
    if(A.page===B.page) return;
    const totalImp = rows.reduce((s,r)=>s+r.impressions,0);
    if(totalImp<5) return;
    // confidence needs: overlap + similar intent + meaningful ranking presence for both
    const sameIntent = A.intent===B.intent;
    const bothRank = A.position<=50 && B.position<=50;
    const shareOfSecond = B.impressions/totalImp;
    let confidence = "LOW";
    if(sameIntent && bothRank && shareOfSecond>=0.15 && B.impressions>=3) confidence = "HIGH";
    else if(bothRank && shareOfSecond>=0.08) confidence = "MEDIUM";
    if(confidence==="LOW") return;
    let action = "INTERNAL LINK";
    if(confidence==="HIGH" && Math.abs(A.position-B.position)<8) action = "MERGE / REPOSITION";
    else if(confidence==="HIGH") action = "CANONICALIZE / CHANGE TARGET KEYWORD";
    cannibalization.push({query, urlA:A.page, urlB:B.page, posA:A.position, posB:B.position,
      impressions:totalImp, clicks: rows.reduce((s,r)=>s+r.clicks,0), intent:A.intent, confidence, action});
  });
  cannibalization.sort((a,b)=>b.impressions-a.impressions);

  // ---- Content clusters (token-overlap clustering over queries) ----
  const clusterInputs = Array.from(byQueryMap.entries()).map(([query,rows])=>{
    const impressions = rows.reduce((s,r)=>s+r.impressions,0);
    const clicks = rows.reduce((s,r)=>s+r.clicks,0);
    const best = rows.slice().sort((a,b)=>a.position-b.position)[0];
    return {query, impressions, clicks, position:best.position, page:best.page, category:best.category,
      buyingIntent:best.buyingIntent, businessValue:best.businessValue, intent:best.intent};
  });
  const rawClusters = clusterQueries(clusterInputs, 0.34).filter(c=>c.length>=1);
  let clusters = rawClusters.map(members=>{
    const impressions = members.reduce((s,m)=>s+m.impressions,0);
    const clicks = members.reduce((s,m)=>s+m.clicks,0);
    const avgPos = members.reduce((s,m)=>s+m.position*Math.max(m.impressions,1),0)/Math.max(impressions,1);
    const urls = [...new Set(members.map(m=>m.page))];
    const commercialCount = members.filter(m=>["TRANSACTIONAL","COMMERCIAL INVESTIGATION","PRODUCT AWARE"].includes(m.intent)).length;
    const category = members.slice().sort((a,b)=>b.impressions-a.impressions)[0].category;
    const businessValue = Math.round(members.reduce((s,m)=>s+m.businessValue*Math.max(m.impressions,1),0)/Math.max(impressions,1));
    return {label:clusterLabel(members.map(m=>({tokens:tokenSet(m.query)}))), members, queryCount:members.length,
      impressions, clicks, ctr: impressions>0?clicks/impressions:0, position:avgPos, urls, commercialCount, category, businessValue};
  }).sort((a,b)=>b.impressions-a.impressions);

  STATE.derived = { qpAgg, pageAgg, byQueryMap, byPageMap, cannibalization, clusters, maxImpressions,
    combinedAvailable: combined.length>0, totalRows: combined.length + queryOnly.length + pageOnly.length };
  return STATE.derived;
}


